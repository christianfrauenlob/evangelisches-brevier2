          },
          {
            "typ": "lesung",
            "anzeige_ref": "Brief S. Jacobi 4, 13—17.",
            "buch": "jakobus",
            "kapitel": 4,
            "verse": "13-17"
          },
          {
            "typ": "lied",
            "titel": "Abermal ein Jahr verflossen",
            "fortsetzung": true,
            "strophen": [
              {
                "links": [
                  "Soll ich denn in dieser Hütten",
                  "Mich noch eine Zeit lang plagen,",
                  "So wirst Du mich überschütten",
                  "Mit Geduld, das weiß ich doch,",
                  "Setze denn dein Herz auf mich,",
                  "Jesu Christe, Du und ich",
                  "Wollen ewig treu verbleiben",
                  "Und von Neuem uns verschreiben."
                ],
                "rechts": [
                  "Jn dem Abend und dem Morgen,",
                  "O mein Rat, besuche mich;",
                  "Laß der Heiden Nahrungsorgen",
                  "Nimmer scheiden mich und Dich;",
                  "Prüf in jedem Augenblick",
                  "Meine Nieren und mich schick,",
                  "Schick mich, daß ich wachend stehe,",
                  "Ehe denn ich schnell vergehe."
                ]
              }
            ]
          },
          {
            "typ": "leitwort_lobgesang",
            "zeilen": [
              "Das Kind Jesus nahm zu an Alter und Weisheit",
              "Bei Gott und den Menschen."
            ]
          }
        ]
