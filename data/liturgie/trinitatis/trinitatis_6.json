          {
            "typ": "lied",
            "titel": "Sobald, o frommer Christ (eig. Les cieux en chaque lieu)",
            "strophen": [
              {
                "links": [
                  "Dir dank ich herziglich,",
                  "Daß Du zur Kindschaft mich",
                  "Erwählt von Ewigkeit;",
                  "Sonst könnte Dir jetzund",
                  "Dein Lob durch Deinen Mund",
                  "Nicht werden ausgebreit.",
                  "Mein Mund Dank singet Dir",
                  "Für alles Gut, das mir,",
                  "Gott, Deine Güt erzeiget,",
                  "Daß sie mein Herz und mich",
                  "Zum Glauben und auf Dich",
                  "So kräftig hat geneiget."
                ]
