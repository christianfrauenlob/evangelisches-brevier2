                "links": [
                  "HErr Christ, man dankt Dir insgemein",
                  "Für Deines Wortes hellen Schein,",
                  "Damit Du uns hast angeblickt",
                  "Und unser mattes Herz erquickt."
                ],
                "rechts": [
                  "Wir saßen vor im Todestal",
