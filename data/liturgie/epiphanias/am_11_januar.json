          {
            "typ": "lied",
            "titel": "Kommt, laßt uns unser Jesulein",
            "melodie": "12",
            "strophen": [
              {
                "links": [
                  "Kommt, laßt uns unser Jesulein",
                  "Besuchen jetzt mit Freuden",
                  "Und samt den Weisen tätig sein;",
                  "Denn das wird unser Leiden",
                  "Verkehren bald in Lieb und Lust:",
                  "Es ist ja uns sein Schatz bewußt;",
                  "Der fröhlich machen",
                  "Das Herz, das hochbestimmet ist,",
                  "Als unser Heiland Jesus Christ,",
                  "Der stärket auch die Schwachen."
                ],
                "rechts": [
                  "Was acht ich Reichtum, Ehr und Pracht,",
                  "Was Schweigen, Tanzen, Springen?",
                  "Ei, das veracht in einer Nacht,",
                  "Kann auch wohl Herzleid bringen;",
                  "Die rechte Lust besitzet nur,",
                  "Wer in Gott, nicht in der Kreatur:",
                  "Nur Gott kann Freud erregen",
                  "Den Schwachen, welche Sünd und Tod",
                  "Oft führen in die höchste Not,",
                  "Ja schier der Höll einlegen."
                ]
              }
            ]
          },
          {
            "typ": "lesung",
            "anzeige_ref": "Evangelium S. Lucae 4, 14, 15.",
            "buch": "lukas",
            "kapitel": 4,
            "verse": "14-15"
          },
          {
            "typ": "leitwort_lobgesang",
            "zeilen": [
              "Zu Dir werden kommen, die Dich verleumdeten,",
              "Und sie werden Deiner Füße Spuren verehren."
            ]
          }
        ],
        "mittag": [
          {
            "typ": "lied",
            "titel": "Kommt, laßt uns unser Jesulein",
            "fortsetzung": true,
            "strophen": [
              {
                "links": [
                  "Kommt, laßt uns mit der Weisen Schar",
                  "Vor dieses Kindlein treten,",
                  "Dasselbe mitten in Gefahr",
                  "Voll Glaubens anzubeten:",
                  "Wer kommen will, der komm jetzt früh",
                  "Und fall in Demut auf die Knie:",
                  "So muß man Ehr erweisen",
                  "Dem HErren aller Herrlichkeit,",
                  "Von ganzer Seele Ihn preisen."
                ]
              }
            ]
          },
